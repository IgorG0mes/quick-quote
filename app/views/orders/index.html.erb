<p style="color: green"><%= notice %></p>

<h1>Orders</h1>

<div id="orders">
  <% @orders.each do |order| %>
    <p>
      Número do pedido: <%= order.id %>
    </p>
    <p>
      Nome do Cliente: <%= order.client.name %>
    </p>
    <p>
      <%= link_to "Detalhes do pedido", order %>
    </p>
  <% end %>
</div>

<%= link_to "Novo pedido", new_order_path %>
