<p style="color: green"><%= notice %></p>

<div>
  <p>Número do Pedido: <%= @order.id %></p>
  <p>Nome do Cliente: <%= @order.client.name %></p>
  <p>Nome do Mecânico: <%= @order.user.name %></p>
  <p>Valor da mão de obra: <%= @order.labor_price %></p>
  <p>Valor total do serviço: <%= @order.amount %></p>
</div>

<div>
  <%= link_to "Editar este pedido", edit_order_path(@order) %> |
  <%= link_to "Voltar a todos pedidos", orders_path %>

  <%= button_to "Destruir este pedido!", @order, method: :delete %>
</div>
