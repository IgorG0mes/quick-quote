<%= stylesheet_link_tag 'index_supplier.css' %>

<div class="viewable">
  <div class="search_bar">
    <div class="box_bar">
      <div class="title-search">
        <p>Nome do fornecedor</p>
      </div>
      <div class="box-search">
        <%= form_tag(suppliers_path, method: :get, data: { turbo_frame: "results", turbo_action: "advance" }) do %>
          <%= text_field_tag :query_name, params[:query_name], class: "searchTerm" %>
          <%= submit_tag "Buscar", class: "searchButton" %>
        <% end %>
      </div>
    </div>
    <div class="box_bar">
      <div class="title-search">
        <p>Telefone ou CNPJ do fornecedor</p>
      </div>
      <div class="box-search">
        <%= form_tag(suppliers_path, method: :get, data: { turbo_frame: "results", turbo_action: "advance" }) do %>
          <%= text_field_tag :query_cnpj, params[:query_cnpj], class: "searchTerm" %>
          <%= submit_tag "Buscar", class: "searchButton" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<%= render "search_result" %>
